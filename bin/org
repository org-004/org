#!/bin/sh
# org: runs on Linux, on the machine that holds the engineers' containers. Nothing in this
# repository is meant to run on a Mac: the host starts that machine with a launcher of its own
# (`org-vm`, kept outside this repository) and passes commands into it.
#
#   org up | down      install or refresh this copy and what it needs here (incus/up.sh)
#   org <anything>     the package, with python3
#
# Symlink this file onto PATH (ln -s "$PWD/bin/org" ~/.local/bin/org); the link is followed back.
self="$0"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *)  self="$(dirname "$self")/$target" ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)

if [ "$(uname -s)" = Darwin ] && [ -z "${ORG_ALLOW_DARWIN:-}" ]; then
  echo "org: this runs inside the VM, not on the Mac. Use org-vm: org-vm up, org-vm talk, org-vm status ..." >&2
  exit 1
fi

case "${1:-}" in
  up)   shift; exec "$root/incus/up.sh" "$@" ;;
  down) shift; exec "$root/incus/up.sh" --down "$@" ;;
esac

PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m org "$@"
