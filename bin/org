#!/bin/sh
# Launcher: run the package from this checkout with whatever python3 is on the machine.
# Symlink it onto PATH (ln -s "$PWD/bin/org" ~/.local/bin/org); the link is followed back here.
self="$0"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *)  self="$(dirname "$self")/$target" ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m org "$@"
